# Configuration for Spanner Replication Demo

# The Google Cloud Project ID to use.
# If left empty, the script automatically uses your currently active gcloud project config.
PROJECT_ID=""

# The Google Cloud region for Dataflow jobs and templates.
REGION="us-central1"

# Source Spanner Instance ID.
# Note: This must match the instance ID created in your Terraform config (spanner.tf) if using Step 1.
SOURCE_INSTANCE="source-instance"

# Source Spanner Database ID.
SOURCE_DB="source-db"

# Destination Spanner Instance ID.
# Note: This must match the instance ID created in your Terraform config (spanner.tf) if using Step 1.
DEST_INSTANCE="dest-instance"

# Destination Spanner Database ID.
DEST_DB="dest-db"

# Execution runner mode for Dataflow templates:
# - 'remote': Run jobs on GCP Dataflow managed service.
# - 'local': Compile and run templates locally via Maven DirectRunner.
DATAFLOW_RUNNER="remote"

# Suppress OpenTelemetry metric export errors in the Python Spanner client.
SPANNER_DISABLE_BUILTIN_METRICS="true"
