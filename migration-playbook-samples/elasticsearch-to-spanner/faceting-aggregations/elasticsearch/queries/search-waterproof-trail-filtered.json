{
  "query": {
    "bool": {
      "must": [
        {
          "multi_match": {
            "query": "waterproof trail",
            "fields": [
              "title^3",
              "description"
            ],
            "operator": "and"
          }
        }
      ],
      "filter": [
        {
          "term": {
            "tenant_id": "tenant-a"
          }
        },
        {
          "term": {
            "status": "active"
          }
        }
      ]
    }
  },
  "post_filter": {
    "bool": {
      "filter": [
        {
          "term": {
            "category": "footwear"
          }
        },
        {
          "term": {
            "brand": "Summit"
          }
        }
      ]
    }
  },
  "size": 5,
  "sort": [
    {
      "rating": "desc"
    },
    {
      "product_id": "asc"
    }
  ],
  "_source": [
    "product_id",
    "title",
    "category",
    "brand",
    "price_cents",
    "rating"
  ],
  "aggs": {
    "categories": {
      "terms": {
        "field": "category",
        "size": 10
      }
    },
    "brands": {
      "terms": {
        "field": "brand",
        "size": 10
      }
    },
    "colors": {
      "terms": {
        "field": "colors",
        "size": 10
      }
    },
    "avg_price_cents": {
      "avg": {
        "field": "price_cents"
      }
    }
  }
}
