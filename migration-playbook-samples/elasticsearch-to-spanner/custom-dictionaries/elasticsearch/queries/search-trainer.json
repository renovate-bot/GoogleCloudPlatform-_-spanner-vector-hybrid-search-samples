{
  "query": {
    "bool": {
      "must": [
        {
          "multi_match": {
            "query": "trainer",
            "fields": ["title^2", "description"]
          }
        }
      ],
      "filter": [
        {"term": {"tenant_id": "tenant-a"}},
        {"term": {"status": "active"}}
      ]
    }
  },
  "_source": ["product_id", "title", "description"]
}
